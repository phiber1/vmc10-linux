10 REM MCX32-SD HARDWARE PROBE FOR VMC10 LINUX
20 REM WRITES PROBE.TXT TO THE CURRENT SD DIRECTORY
30 CLS:PRINT "PROBING... (ABOUT 2 MINUTES)"
40 OPEN "O",#1,"PROBE.TXT"
50 PRINT #1,"REGS 04 06 07 0F:";PEEK(4);PEEK(6);PEEK(7);PEEK(15)
60 PRINT #1,"RAM MAP, 1 CHAR PER 256 BYTES: 1=RAM 0=NOT F=FLASH(SKIPPED)"
70 R$=""
80 FOR P=1 TO 190:A=P*256
90 IF A>=&H2000 AND A<&H4000 THEN R$=R$+"F":GOTO 120
100 X=PEEK(A):POKE A,255-X:Y=PEEK(A):POKE A,X
110 IF Y=255-X THEN R$=R$+"1" ELSE R$=R$+"0"
120 IF LEN(R$)=32 THEN PRINT #1,HEX$(A-31*256);" ";R$:R$=""
130 NEXT P
140 PRINT #1,"         ";R$
150 PRINT #1,"MAPPED 4200 VS 4200@:";PEEK(&H4200);PEEK@(&H4200)
160 PRINT #1,"FLASH SUMS PER 1K (EVERY 4TH BYTE)"
170 FOR A=&H2000 TO &H3FFF STEP 1024:GOSUB 300:NEXT A
180 FOR A=&HC000 TO &HFFFF STEP 1024:GOSUB 300:NEXT A
190 PRINT #1,"END"
200 CLOSE #1
210 PRINT "DONE - PROBE.TXT WRITTEN":END
300 S=0:FOR I=0 TO 1023 STEP 4:S=S+PEEK(A+I):NEXT I
310 PRINT #1,HEX$(A);S:RETURN
